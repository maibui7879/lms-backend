# Loaded automatically from this service directory; shell variables take precedence.
NODE_ENV=development
PORT=3002
MOCK_AUTH=false
# Explicit opt-in for a disposable development database only; never staging/production.
DB_SYNC=false
JWT_PUBLIC_KEY=
JWT_ISSUER=identity-service
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/course
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672
IDENTITY_URL=http://127.0.0.1:3001
