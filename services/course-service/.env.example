# Loaded automatically from this service directory; shell variables take precedence.
NODE_ENV=development
PORT=3002
MOCK_AUTH=false
# Explicit opt-in for a disposable development database only; never staging/production.
DB_SYNC=false
JWT_PUBLIC_KEY=
JWT_ISSUER=identity-service
# Separate internal HTTP credential shared with authorized Quiz/Learning callers.
COURSE_SERVICE_TOKEN=
# Staging/production: verify short-lived internal JWTs instead of the local token.
INTERNAL_JWT_PUBLIC_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/course
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672
IDENTITY_URL=http://127.0.0.1:3001
# Credential Course uses to check current account access with Identity.
IDENTITY_SERVICE_TOKEN=
LEARNING_URL=http://127.0.0.1:3004
# Credential configured by Learning for its internal migration endpoint.
LEARNING_SERVICE_TOKEN=
