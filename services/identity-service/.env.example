# Planned integration settings; only PORT is currently read by the scaffold.
# Export variables in the shell; no automatic .env loader is wired yet.
NODE_ENV=development
PORT=3001
MOCK_AUTH=false
JWT_ISSUER=identity-service
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/identity
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
INTERNAL_JWT_PUBLIC_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
OTP_TTL_MINUTES=10

ADMIN_EMAIL=admin@lms.edu.vn
ADMIN_PASSWORD=ChangeMe@123456
ADMIN_DISPLAY_NAME=System Admin 






