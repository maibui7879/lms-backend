# Copy to .env and fill the database, user-token keys and internal verification key.
# ConfigModule loads .env; existing process variables take precedence.
NODE_ENV=development
PORT=3001
MOCK_AUTH=false
JWT_ISSUER=identity-service
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/identity
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
INTERNAL_JWT_PUBLIC_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
OTP_TTL_MINUTES=10

ADMIN_EMAIL=admin@lms.edu.vn
ADMIN_PASSWORD=ChangeMe@123456
ADMIN_DISPLAY_NAME=System Admin 

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback





