# Progress reads PORT, NODE_ENV, MOCK_AUTH, DATABASE_URL, COURSE_URL and RABBITMQ_URL.
# Export variables in the shell; no automatic .env loader is wired yet.
NODE_ENV=development
PORT=3004
MOCK_AUTH=false
JWT_PUBLIC_KEY=
JWT_ISSUER=identity-service
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/learning
# Set RABBITMQ_URL to enable the quiz result consumer.
RABBITMQ_URL=
COURSE_URL=http://127.0.0.1:3002
# Required for internal Course APIs, including every pinned structure lookup.
COURSE_SERVICE_TOKEN=
# Credential accepted only by Learning's internal migration endpoint.
LEARNING_SERVICE_TOKEN=
# Read-only credential shared with Quiz for internal skill lookup.
LEARNING_SKILL_LOOKUP_TOKEN=
# Mastery level boundaries. Shared by all courses in this Learning instance.
LEARNING_MASTERY_DEVELOPING_MIN=40
LEARNING_MASTERY_PROFICIENT_MIN=70
# Progress sync calls the internal Quiz API with a service credential.
QUIZ_URL=http://127.0.0.1:3003
QUIZ_SERVICE_TOKEN=
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017
MONGODB_DATABASE=lms_learning
