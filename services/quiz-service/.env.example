# Copy to services/quiz-service/.env for local development; do not commit secrets.
# ConfigModule loads .env, and process environment values take precedence.
NODE_ENV=development
PORT=3003
MOCK_AUTH=false
JWT_PUBLIC_KEY=
JWT_ISSUER=identity-service
IDENTITY_URL=http://127.0.0.1:3001
# Private key for signing short-lived service JWTs. Identity must trust its
# public counterpart through INTERNAL_JWT_PUBLIC_KEY.
IDENTITY_INTERNAL_JWT_PRIVATE_KEY=
# Public key used to verify service-to-service JWTs addressed to Quiz Service.
INTERNAL_JWT_PUBLIC_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/quiz
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672
COURSE_URL=http://127.0.0.1:3002
